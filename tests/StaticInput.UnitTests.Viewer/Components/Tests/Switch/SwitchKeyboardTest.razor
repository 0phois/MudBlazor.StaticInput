<EditForm Model="Input" method="post" OnSubmit="OnSubmit" FormName="keyboard">
    <button type="button" id="before-switch">Before</button>
    <MudStaticSwitch @bind-Value="Input.Accept" Color="Color.Primary" Label="Accept" For="() => Input.Accept" />
    <MudStaticButton FormAction="FormAction.Submit" Color="Color.Primary" Variant="Variant.Filled">Submit</MudStaticButton>
</EditForm>

@if (_submitted)
{
    <MudText id="submitted-value">Submitted: @Input.Accept</MudText>
}

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    private bool _submitted;

    private void OnSubmit() => _submitted = true;

    private sealed class InputModel
    {
        public bool Accept { get; set; }
    }
}
